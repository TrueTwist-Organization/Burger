DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect old .html URLs to .php equivalents
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.+)\.html$ $1.php [L,R=301,NC]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.+)\.html$ $1.php [L,R=301,NC]
</IfModule>
